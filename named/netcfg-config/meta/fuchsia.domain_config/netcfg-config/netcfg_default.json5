{
    dns_config: {
        servers: [
            "8.8.8.8",
            "8.8.4.4",
            "2001:4860:4860::8888",
            "2001:4860:4860::8844",
        ],
    },
    filter_config: {
        nat_rules: [],
        rdr_rules: [],
        rules: [
            // ==========================================
            // === TCP INBOUND                        ===
            // ==========================================
            // Production ports (go/nest-port-usage)
            "pass in proto tcp to range 8008:8009;",
            "pass in proto tcp to port 8443;",

            // --- SoftAP Isolation (TCP) ---
            "drop in proto tcp devclass ap to range 0:15999;",

            "pass in proto tcp to port 8012;",
            "pass in proto tcp to port 9000;",
            "pass in proto tcp to port 9222;",
            "pass in proto tcp to range 10001:10002;",
            "pass in proto tcp to range 10005:10007;",
            "pass in proto tcp to range 10010:10011;",
            "pass in proto tcp to port 10101;",
            "pass in proto tcp to range 11095:11096;",

            // --- Global Inbound Pass & Catch-All Drop ---
            "pass in proto tcp to range 16000:65535;",
            "drop in proto tcp to range 0:65535;",

            // ==========================================
            // === UDP INBOUND                        ===
            // ==========================================
            // Production ports (go/nest-port-usage)
            "pass in proto udp to range 67:68;",
            "pass in proto udp to port 1900;",
            "pass in proto udp to port 5004;",
            "pass in proto udp to port 5353;",
            "pass in proto udp to port 5540;",
            "pass in proto udp to range 8700:8800;",
            "pass in proto udp to range 10001:10002;",
            "pass in proto udp to port 10004;",
            "pass in proto udp to port 10006;",
            "pass in proto udp to port 10008;",
            "pass in proto udp to port 10101;",
            "pass in proto udp to port 11095;",

            // --- SoftAP Isolation (UDP) ---
            // We choose to do a non-ephemeral port drop for AP after the previous
            // rules so that the device can use these services to provision the WiFi
            // network (through mDNS discovery and DHCP, for example).
            "drop in proto udp devclass ap to range 0:15999;",

            // --- Global Inbound Pass & Catch-All Drop ---
            "pass in proto udp to range 16000:65535;",
            "drop in proto udp to range 0:65535;",
        ],
    },
    filter_enabled_interface_types: [
        "wlanap",
        "wlanclient",
    ],
    interface_metrics: {
        wlan_metric: 90,
        eth_metric: 100,
    },
}
