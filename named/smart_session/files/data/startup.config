        "component_args": [
            {
                "uri": "fuchsia-pkg://fuchsia.com/kronk#meta/kronk.cmx",
                "args": [
                    "--backend_type=auto",
                    "--enable_bluetooth_module=false",
                    "--enable_cast_assistant_media_module",
                    "--mic_sensitivity=-38",
                    "--platform_audio_input_channel_count=2",
                    "--platform_audio_reference_input_channel_count=1"
                ]
            },
            {
                "uri": "fuchsia-pkg://fuchsia.com/nest_policy_agent#meta/nest_policy_agent.cmx",
                "args": [
                    "--daily-restart-enabled",
                    "--interop-concierge-enabled",
                    "--interop-led-enabled",
                    "--max-output-volume-dba1m=86",
                    "--max-tts-volume-dba1m=79",
                    "--max_privacy_led_brightness=0.3",
                    "--max_privacy_led_lux=382.5",
                    "--min-tts-volume-dba1m=45",
                    "--min_privacy_led_brightness=0.01",
                    "--nightly-reboot-enabled"
                ]
            },
            {
                "uri": "fuchsia-pkg://fuchsia.com/stellar_agent#meta/stellar_agent.cmx",
                "args": [
                    "--libaa-classifiers-audio-gain-linear=4.2",
                    "--tensorflow-classifiers-audio-gain-linear=16.8"
                ]
            }
        ],
