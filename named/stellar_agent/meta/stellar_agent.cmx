{
  "program": {
    "binary": "cast_agent_exe",
    "args": [ "--stellar-agent" ]
  },
  "sandbox": {
    "features": [],
    "services": [
      "fuchsia.castsetup.StateWatcher",
      "fuchsia.logger.LogSink",
      "fuchsia.media.Audio",
      "fuchsia.modular.ComponentContext",
      "fuchsia.posix.socket.Provider",
      "fuchsia.settings.Audio",
      "fuchsia.settings.Input",
      "google.libinteraction.PerceptionAudioInput",
      "google.libinteraction.PerceptionControl",
      "google.libinteraction.PerceptionEventsWatcher"
    ]
  }
}
