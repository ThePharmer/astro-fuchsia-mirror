{
  "files": [
    {
      "path": "weave.crt",
      "validators": [
        {
          "name": "pass"
        }
      ]
    },
    {
      "path": "weave_device_id",
      "validators": [
        {
          "name": "text"
        },
        {
          "name": "size",
          "args": {
            "max": 32
          }
        }
      ]
    },
    {
      "path": "weave.key",
      "validators": [
        {
          "name": "size",
          "args": {
            "max": 256
          }
        }
      ]
    },
    {
      "path": "weave_pairing_code",
      "validators": [
        {
          "name": "size",
          "args": 34
        }
      ]
    }
  ]
}
