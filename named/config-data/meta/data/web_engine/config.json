{
  "allow-protected-graphics": true,
  "allocator-dump-names": [
    "blink_gc/*",
    "discardable/*",
    "gpu/*",
    "malloc/*",
    "partition_alloc/*",
    "skia/*",
    "v8/*",
    "web_cache/*"
  ],
  "command-line-args": {
    "disable-features": "MojoVideoCapture,site-per-process,IntensiveWakeUpThrottling",
    "disable-quic": "true",
    "disable-mipmap-generation": "",
    "enable-features": "OriginTrials,AudioWorkletThreadRealtimePriority",
    "enable-cast-streaming-receiver": "",
    "enable-low-end-device-mode": "true",
    "enable-scaling-clipped-images": "",
    "force-gpu-mem-available-mb": "64",
    "force-gpu-mem-discardable-limit-mb": "16",
    "force-max-texture-size": "2048",
    "google-api-key": "AIzaSyCmzTeF9YpBqhTuTKlSYSqYnDsZ-YTTEDQ",
    "gpu-rasterization-msaa-sample-count": "0",
    "max-decoded-image-size-mb": "10",
    "min-height-for-gpu-raster-tile": "128",
    "min-video-decoder-output-buffer-size": "1280x720",
    "vulkan-heap-memory-limit-mb": "160",
    "vulkan-sync-cpu-memory-limit-mb": "96",
    "webgl-msaa-sample-count": "8"
  },
  "force-protected-video-buffers": true,
  "use-overlays-for-video": true
}