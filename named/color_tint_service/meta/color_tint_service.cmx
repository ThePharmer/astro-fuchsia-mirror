{
  "program": {
    "binary": "cast_agent_exe",
    "args": [ "--light-eq-agent" ]
  },
  "sandbox": {
    "dev": [
      "class/light"
    ],
    "features": [
      "config-data",
      "isolated-persistent-storage"
    ],
    "services": [
      "fuchsia.castsetup.ApiRegistry",
      "fuchsia.factory.MiscFactoryStoreProvider",
      "fuchsia.feedback.CrashReportingProductRegister",
      "fuchsia.intl.PropertyProvider",
      "fuchsia.legacymetrics.MetricsRecorder",
      "fuchsia.logger.LogSink",
      "fuchsia.media.sessions2.Discovery",
      "fuchsia.modular.ComponentContext",
      "fuchsia.sys.Launcher",
      "fuchsia.ui.brightness.ColorAdjustmentHandler",
      "fuchsia.ui.brightness.Control",
      "fuchsia.ui.policy.DisplayBacklight",
      "fuchsia.settings.Audio",
      "fuchsia.settings.Display",
      "fuchsia.settings.Input",
      "fuchsia.settings.Light",
      "fuchsia.migration.DisplayProvider",
      "fuchsia.posix.socket.Provider",
      "google.cast.cloudsettings.CloudSettingsManager",
      "google.proximity.ProximityService",
      "google.cast.setup.EurekaInfoManager"
    ]
  }
}
