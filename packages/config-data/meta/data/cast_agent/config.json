{
    "castui-force-update-disconnect-timeout-ms": 180000,
    "default-eureka-name-prefix": "NestHub",
    "disable-features": "enable_thread_network_management,enable_auto_software_update_toggle,enable_power_manager",
    "enable-background-apps": true,
    "enable-castui": true,
    "enable-hotspot-controller": true,
    "enable-system-updater": true,
    "force-media-resolution-height": 720,
    "force-media-resolution-width": 1280,
    "require-wlan": true,
    "setup-ssid-suffix": "u",
    "use-frame-host-for-smart-home": true,
    "user-eq-max-bands": "2"
}